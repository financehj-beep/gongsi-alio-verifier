const doc = {
  paragraphs: cases.map(([text], i) => ({ text, location: { paragraph: i + 1 } })),
} as unknown as Parameters<typeof checkSpelling>[0];

const t0 = Date.now();
const found = await checkSpelling(doc);
const secs = ((Date.now() - t0) / 1000).toFixed(1);
let hit = 0, planted = 0, fp = 0;
const flagged = new Map<number, string[]>();
for (const f of found) {
  const locs = [f.hwpLocation, ...(f.moreLocations ?? []).map((m) => m.hwpLocation)];
  for (const l of locs) {
    if (!l) continue;
    const arr = flagged.get(l.paragraph) ?? [];
    arr.push(f.suggestion ?? "");
    flagged.set(l.paragraph, arr);
  }
}
cases.forEach(([text, wrong], i) => {
  const got = flagged.get(i + 1);
  if (wrong) {
    planted++;
    if (got) hit++;
    else console.log(`못 찾음: ${text}`);
  } else if (got) {
    fp++;
    console.log(`오탐: ${text} → ${got.join(", ")}`);
  }
});
console.log(`심은 오류 ${planted}개 중 ${hit}개 (${((hit / planted) * 100).toFixed(1)}%), 오탐 ${fp}건, ${secs}초`);
